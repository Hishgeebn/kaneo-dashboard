# Kaneo API (server-side only — never prefix these with NEXT_PUBLIC_)
KANEO_API_URL=https://api.kaneo.ufe.edu.mn/api
KANEO_API_TOKEN=
# Kaneo workspace to read (every project in it). The id is in Kaneo's URLs / workspace settings.
KANEO_WORKSPACE_ID=
# Skip projects whose name contains any of these (comma-separated, case-insensitive)
KANEO_EXCLUDE_PROJECTS=staging,test

# How long fetched Kaneo data is cached, in seconds
KANEO_REVALIDATE_SECONDS=60

# Kaneo user ids whose resolutions count as "Azaa AI" (comma-separated).
# Empty = everything counts as "Ажилтан".
KANEO_AI_USER_IDS=

# Case-insensitive substrings that mark test submissions to exclude
KANEO_TEST_MARKERS=b24fm1195,pentest,tes test

# Projects whose cards are the chatbot's requests (name contains, comma-separated). With the chatbot
# API below working, their numbers come from the API instead (so they are not counted twice).
KANEO_CHATBOT_PROJECTS=chatbot

# Realtime: secret Kaneo signs its webhook deliveries with (X-Kaneo-Signature, HMAC-SHA256).
# Empty = POST /api/kaneo/webhook refuses everything. Generate e.g. `openssl rand -hex 32`.
KANEO_WEBHOOK_SECRET=

# Chatbot backend (server-side only). Both empty = Kaneo only; the «Чатбот» view then uses
# the chatbot's Kaneo cards. The token is the backend's REQUEST_DASHBOARD_SERVICE_TOKEN.
CHATBOT_API_URL=
CHATBOT_DASHBOARD_TOKEN=
